          "alertType": "LogAlert",
          "query": "Operation | where OperationCategory == \"Data Collection Status\" | where Detail contains \"OverQuota\"",
          "timeAggregation": "Count",
          "operator": "GreaterThan",
          "threshold": 0,
          "evaluationFrequency": "PT1M",
          "windowSize": "PT1D",
          "resourceType": "Microsoft.OperationalInsights/workspaces",
          "enabled": true,
          "autoMitigate": true

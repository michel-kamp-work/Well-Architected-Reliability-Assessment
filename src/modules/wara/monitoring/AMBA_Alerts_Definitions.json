{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Azure Monitor Baseline Alerts (AMBA) - Monitor Definitions",
  "description": "Comprehensive collection of Azure Monitor alert definitions based on the Azure Monitor Baseline Alerts (AMBA) repository",
  "version": "1.0.0",
  "metadata": {
    "source": "https://github.com/Azure/azure-monitor-baseline-alerts",
    "createdDate": "2025-08-19",
    "lastUpdated": "2025-08-19",
    "author": "AMBA Alerts Generator"
  },
  "alertDefinitions": {
    "compute": {
      "virtualMachines": [
        {
          "alertName": "VM CPU Percentage Alert",
          "description": "Percentage CPU usage",
          "severity": 2,
          "metricName": "Percentage CPU",
          "operator": "GreaterThan",
          "threshold": 85,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM Memory Percentage Alert",
          "description": "Available Memory Bytes",
          "severity": 2,
          "metricName": "Available Memory Bytes",
          "operator": "LessThan",
          "threshold": 1073741824,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM Data Disk Space Alert",
          "description": "Data disk space usage",
          "severity": 2,
          "metricName": "LogicalDisk Avg Disk Space Used %",
          "operator": "GreaterThan",
          "threshold": 90,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT15M",
          "windowSize": "PT15M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM OS Disk Space Alert",
          "description": "OS disk space usage",
          "severity": 2,
          "metricName": "LogicalDisk Avg Disk Space Used %",
          "operator": "GreaterThan",
          "threshold": 90,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT15M",
          "windowSize": "PT15M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM HeartBeat Alert",
          "description": "Virtual machine heartbeat monitoring",
          "severity": 1,
          "alertType": "LogAlert",
          "query": "Heartbeat | summarize TimeGenerated=max(TimeGenerated) by Computer | where TimeGenerated < ago(5m)",
          "timeAggregation": "Count",
          "operator": "GreaterThan",
          "threshold": 0,
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM Network Read Alert",
          "description": "Network bytes received",
          "severity": 2,
          "metricName": "Network In Total",
          "operator": "GreaterThan",
          "threshold": 500000000,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM Network Write Alert",
          "description": "Network bytes sent",
          "severity": 2,
          "metricName": "Network Out Total",
          "operator": "GreaterThan",
          "threshold": 500000000,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM OS Disk Read Latency Alert",
          "description": "OS disk read latency",
          "severity": 2,
          "metricName": "OS Disk Read Latency",
          "operator": "GreaterThan",
          "threshold": 30,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM OS Disk Write Latency Alert",
          "description": "OS disk write latency",
          "severity": 2,
          "metricName": "OS Disk Write Latency",
          "operator": "GreaterThan",
          "threshold": 30,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM Data Disk Read Latency Alert",
          "description": "Data disk read latency",
          "severity": 2,
          "metricName": "Data Disk Read Latency",
          "operator": "GreaterThan",
          "threshold": 30,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        },
        {
          "alertName": "VM Data Disk Write Latency Alert",
          "description": "Data disk write latency",
          "severity": 2,
          "metricName": "Data Disk Write Latency",
          "operator": "GreaterThan",
          "threshold": 30,
          "timeAggregation": "Average",
          "evaluationFrequency": "PT1M",
          "windowSize": "PT5M",
          "resourceType": "Microsoft.Compute/virtualMachines",
          "enabled": true,
          "autoMitigate": true
        }
      ]
    },
